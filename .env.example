# Configuración del Servidor Hundir la Flota
PORT=3005
HOST=0.0.0.0
NODE_ENV=development

# URL pública de la aplicación (usada para generar enlaces de invitación)
# En producción cambiar por tu dominio, ej: https://batalla.midominio.com
APP_URL=http://localhost:3005

# Tiempo máximo de espera para reconexión de un jugador desconectado (en segundos)
RECONNECT_TIMEOUT_SEC=300

# Base de datos SQLite
DATABASE_PATH=./data/battleship.db
